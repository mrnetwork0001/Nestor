{
  "name": "nestor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Nestor: an AI concierge that scouts rentals, emails landlords from its own inbox, negotiates terms, books tours, and audits your lease.",
  "scripts": {
    "dev": "convex dev --tail-logs pause-on-deploy --start \"vite\"",
    "dev:backend": "convex dev --tail-logs always",
    "dev:frontend": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p convex --noEmit",
    "env:push": "node scripts/push-env.mjs",
    "auth:keys": "node scripts/setup-auth-keys.mjs",
    "deploy": "convex deploy -y && static-hosting deploy --skip-convex"
  },
  "dependencies": {
    "@agentmail/convex": "0.1.0",
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.95",
    "@convex-dev/rate-limiter": "0.4.0",
    "@convex-dev/static-hosting": "0.2.1",
    "@firecrawl/firecrawl-convex": "0.1.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "clsx": "^2.1.1",
    "convex": "1.46.0",
    "convex-helpers": "^0.1.124",
    "lucide-react": "^1.47.0",
    "openai": "7.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
